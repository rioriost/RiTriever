# Example Apple Container settings. Scripts do not automatically source .env.
# To use this file: set -a; . ./.env.example; set +a
RITRIEVER_MARIADB_VERSION=11.8
RITRIEVER_MYSQL_VERSION=9.4

APPLE_CONTAINER_WP_PORT=8081
APPLE_CONTAINER_EMBEDDING_PORT=18080

# Keep local smoke-test vectors small. The setup script writes this value
# to the plugin setting before activation so the vector table matches it.
RITRIEVER_EMBEDDING_DIMENSIONS=16

# Compatibility runs use separate ports and unique test resource names.
RITRIEVER_COMPAT_PORT=18081
RITRIEVER_COMPAT_EMBEDDING_PORT=19080
